{
    "If Statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition} then",
            "\t$0",
            "conclude"
        ],
        "description": "Creates an if statement"
    },

    "If Maybe Statement": {
        "prefix": "if maybe",
        "body": [
            "if ${1:condition} then",
            "\t$0",
            "maybe",
            "\t$0",
            "conclude"
        ],
        "description": "Creates an if-maybe statement"
    },

    "Full Declare Statement": {
        "prefix": "declare",
        "body": [
            "declare ${1:name} as type = value, resort resortValue"
        ],
        "description": "Creates a full declare statement"
    },

    "While Loop": {
        "prefix": "while",
        "body": [
            "while ${1:condition} do",
            "\t$0",
            "conclude"
        ],
        "description": "Creates a while loop"
    },

    "For Loop": {
        "prefix": "for",
        "body": [
            "for i = ${1:integer} to upTo, step 1 do",
            "\t$0",
            "conclude"
        ],
        "description": "Creates a for loop"
    },

    "Foreach Loop": {
        "prefix": "foreach",
        "body": [
            "foreach item in ${1:iterable} do",
            "\t$0",
            "conclude"
        ],
        "description": "Creates a foreach loop"
    },

    "Task Definition": {
        "prefix": "task",
        "body": [
            "define taskType name with (paramType param) do",
            "\t$0",
            "conclude"
        ],
        "description": "Creates a basic and editable task definition"
    }
}