def native function randInt with (min as int, max as int) return int;

def native function random with (min as float, max as float) return float;

def native function shuffle with (toShuffle as list) return list;

def native function shuffleNow with (toShuffle as list);

def native function weightedChoice with (choices as list, weights... as int);

def native function seed with (seedNumber as int);