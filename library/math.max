// All floats can accept integers too

define native function sqrt with (number as float) return float;

define native function cbrt with (number as float) return float;

define native function root with (number1 as float, number2 as float) return float;

define native function log10 with (number as float) return float;

define native function log with (number1 as float, number2 as float) return float;

define native function loge with (number as float) return float;

