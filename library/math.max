define native function iCos with (number as float) return float;

define native function iSin with (number as float) return float;

define native function iTan with (number as float) return float;

define native function iSec with (number as float) return float;

define native function iCosec with (number as float) return float;

define native function iCotan with (number as float) return float;

define native function cosh with (number as float) return float;

define native function sinh with (number as float) return float;

define native function tanh with (number as float) return float;

define native function iCosh with (number as float) return float;

define native function iSinh with (number as float) return float;

define native function iTanh with (number as float) return float;

