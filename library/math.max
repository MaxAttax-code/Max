// All floats can accept integers too

def native function sqrt with (number as float) return float;

def native function cbrt with (number as float) return float;

def native function root with (number1 as float, number2 as float) return float;

def native function log10 with (number as float) return float;

def native function log with (number1 as float, number2 as float) return float;

def native function loge with (number as float) return float;

def native function cos with (number as float) return float;

def native function sin with (number as float) return float;

def native function tan with (number as float) return float;

def native function sec with (number as float) return float;

def native function cosec with (number as float) return float;

def native function cotan with (number as float) return float;

def native function iCos with (number as float) return float;

def native function iSin with (number as float) return float;

def native function iTan with (number as float) return float;

def native function iSec with (number as float) return float;

def native function iCosec with (number as float) return float;

def native function iCotan with (number as float) return float;

def native function cosh with (number as float) return float;

def native function sinh with (number as float) return float;

def native function tanh with (number as float) return float;

def native function iCosh with (number as float) return float;

def native function iSinh with (number as float) return float;

def native function iTanh with (number as float) return float;

def native function reciprocal with (number as float) return float;

def native function floor with (number as float) return float;

